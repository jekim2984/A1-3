# Slofa English Environment Variables Template
# ⚠️ 주의: 실제 API Key는 GitHub에 절대 올리지 마세요!
# Vercel 배포 시에는 [Vercel 프로젝트 > Settings > Environment Variables]에 등록하세요.

# Google Gemini API 키 (권장 - 100% 무료 티어로 빠른 시작 가능)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API 키 (선택 사항 - 미등록 시 내장 스마트 프리셋 및 Gemini 사용)
# OPENAI_API_KEY=your_openai_api_key_here
